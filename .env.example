# Copy to .env at the repo root. Used by docker-compose.yml (backend + frontend build) and by
# `python swarm.py` directly for local dev.

# --- required ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- auth (see api/auth.py) ---
# Unset = no auth, matches today's local-dev behavior. Set this before the backend is reachable from
# anywhere but localhost — it runs shell/dev-agent commands against whatever repo_path it's given.
API_KEY=

# --- docker-compose only ---
# Host directory containing the repos you'll point the app at; mounted read-write into the backend
# container at /repos. Use /repos/<project-name> as repo_path in the app.
REPOS_DIR=./repos
# Where a browser/phone can actually reach the backend (its public URL, not the compose service
# name) — baked into the frontend's JS bundle at build time. Leave unset for local-network testing;
# the app's Settings screen can also set/override this per-device after the fact.
VITE_API_BASE_URL=

# --- optional: lessons-learned memory (see orchestrator/memory.py) ---
# Whole layer no-ops if unset — nothing else in the pipeline depends on it.
SUPABASE_URL=
SUPABASE_KEY=
